extends SceneTree
## Writes scripts/avatar/part_colors.gd: the main color of every character part
## that can be recolored, read from where its UVs land on the pack's palette.
## Needs the licensed art (see the README). Run it again after the pack changes:
##   godot --headless -s scripts/dev/part_colors.gd

const OUT := "res://scripts/avatar/part_colors.gd"
const PALETTE := "res://itHappy/Cute_Characters/textures/Demonstration_Textures_4.png"
const PARTS := "res://itHappy/Cute_Characters/prefabs/assets/"
const FOLDERS := ["body", "ears", "hairstyle", "outwear", "pants", "shorts", "outfit", "shoes", "hat"]


func _init() -> void:
	var palette := Image.load_from_file(ProjectSettings.globalize_path(PALETTE))
	var lines := PackedStringArray()
	for folder in FOLDERS:
		var files := DirAccess.get_files_at(PARTS + folder)
		for file in files:
			if file.get_extension() != "tscn":
				continue
			var key: String = folder + "/" + file.get_basename()
			var color := _main_color(load(PARTS + key + ".tscn") as PackedScene, palette)
			lines.append('\t"%s": "%s",' % [key, color.to_html(false)])
	var text := """class_name PartColors
extends RefCounted
## Generated by scripts/dev/part_colors.gd; don't edit by hand.
## The main color of each recolorable Cute Characters part (see CharacterParts).

const MAIN := {
%s
}
""" % "\n".join(lines)
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string(text)
	print("[part_colors] wrote %d parts to %s" % [lines.size(), OUT])
	quit()


## The color covering the most surface, from 512 coarse color buckets.
func _main_color(scene: PackedScene, palette: Image) -> Color:
	var node := scene.instantiate()
	var area := {}
	var sum := {}
	var size := Vector2(palette.get_width() - 1, palette.get_height() - 1)
	for mesh_node: MeshInstance3D in node.find_children("*", "MeshInstance3D", true, false):
		for s in mesh_node.mesh.get_surface_count():
			var mat := mesh_node.get_active_material(s) as BaseMaterial3D
			if mat == null or mat.resource_name != "Color":
				continue
			var arrays := mesh_node.mesh.surface_get_arrays(s)
			var verts: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
			var uvs: PackedVector2Array = arrays[Mesh.ARRAY_TEX_UV]
			var idx: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
			for t in range(0, idx.size(), 3):
				var a := idx[t]
				var b := idx[t + 1]
				var c := idx[t + 2]
				var weight := (verts[b] - verts[a]).cross(verts[c] - verts[a]).length()
				var uv := ((uvs[a] + uvs[b] + uvs[c]) / 3.0).clamp(Vector2.ZERO, Vector2.ONE)
				var px := palette.get_pixelv(Vector2i(uv * size))
				var bucket := Vector3i(int(px.r * 7.99), int(px.g * 7.99), int(px.b * 7.99))
				area[bucket] = area.get(bucket, 0.0) + weight
				sum[bucket] = sum.get(bucket, Color(0, 0, 0, 0)) + px * weight
	node.free()
	var best: Variant = null
	for bucket in area:
		if best == null or area[bucket] > area[best]:
			best = bucket
	if best == null:
		return Color.WHITE
	var total: Color = sum[best] / area[best]
	total.a = 1.0
	return total
